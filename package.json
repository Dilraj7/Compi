    "ical.js": "2.2.1",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/doto": "^5.3.0",
